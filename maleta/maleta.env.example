# Copy to maleta.env (git-ignored) and fill in. Copie para maleta.env (ignorado pelo git) e preencha.

# ROM code of the DS18B20 probe, as the cold-monitor-edge ESP32 prints it on the serial monitor
# Código ROM da sonda DS18B20, como o ESP32 do cold-monitor-edge mostra no monitor serial
PROBE=

# Broker login of the cold-monitor-edge ESP32: its id (cm-xxxxxx, also on the serial monitor) and the password set
# in its menuconfig. The launcher creates the user if it is missing.
# Login do ESP32 do cold-monitor-edge no broker: o id (cm-xxxxxx) e a senha do menuconfig dele.
COLD_DEVICE_ID=
COLD_DEVICE_PASSWORD=

# Range of the demo probe, used when the launcher registers it: room temperature is inside, a glass of ice is below
# Faixa da sonda da demo: a temperatura ambiente fica dentro, o copo com gelo fica abaixo do mínimo
PROBE_MIN=10
PROBE_MAX=35
