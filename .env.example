# Copy to .env and fill in. .env is git-ignored: never commit it.

# PostgreSQL password, used by the database and the backend (required)
DB_PASSWORD=change-me

# Host port of the dashboard; the API is served on the same port under /api
DASHBOARD_PORT=8090

# Telegram alerts (optional; alerts are only logged while either is empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Any other backend variable can go here too, e.g.
# ALERT_OFFLINE_AFTER=5m

# Simulator, only used with --profile simulator
# SIM_INTERVAL=5s
# SIM_EXCURSION_PROBABILITY=0.02
