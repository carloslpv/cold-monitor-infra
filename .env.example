# Copy to .env and fill in. .env is git-ignored: never commit it.

# PostgreSQL password, used by the database and the backend (required)
DB_PASSWORD=change-me

# Dashboard login (password of at least 8 characters)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Key sensors send in the X-API-Key header (at least 16 characters), e.g. from: openssl rand -hex 32
DEVICE_API_KEY=change-me-to-a-long-random-key

# Host port of the dashboard; the API is served on the same port under /api
DASHBOARD_PORT=8090

# Telegram alerts (optional; alerts are only logged while either is empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Any other backend variable can go here too, e.g.
# ALERT_OFFLINE_AFTER=5m

# Simulator, only used with --profile simulator
# SIM_INTERVAL=5s
# SIM_EXCURSION_PROBABILITY=0.02

# Public demo, only used with compose.demo.yaml (see README.md)
# DEMO_DOMAIN=cold-monitor-demo.duckdns.org
# VIEWER_USERNAME=demo
# VIEWER_PASSWORD=change-me-please
